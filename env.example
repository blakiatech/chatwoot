### 🔗 URL pública de tu instancia
FRONTEND_URL=https://chat.tudominio.com

### 🔐 Clave secreta (genera una segura con `rails secret`)
SECRET_KEY_BASE=REPLACE_ME_WITH_SECURE_KEY

### ⚙️ Entorno
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker

### 🗒️ Logs y rendimiento
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
LOG_SIZE=500
RAILS_MAX_THREADS=10
SIDEKIQ_CONCURRENCY=10

### 🌍 Idioma por defecto
DEFAULT_LOCALE=en

### 💾 Base de datos PostgreSQL
POSTGRES_HOST=chatwoot-postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=REPLACE_ME_DB_PASSWORD

### ⚡ Redis
REDIS_URL=redis://chatwoot-redis:6379

### 🔐 Control de cuentas
ENABLE_ACCOUNT_SIGNUP=false

### 📦 Almacenamiento de archivos
ACTIVE_STORAGE_SERVICE=local

### 📧 SMTP (ejemplo usando Zoho o similar)
MAILER_DELIVERY_METHOD=smtp
MAILER_SENDER_EMAIL=tuemail@tudominio.com

SMTP_DOMAIN=tudominio.com
SMTP_ADDRESS=smtp.tudominio.com
SMTP_PORT=587
SMTP_USERNAME=tuemail@tudominio.com
SMTP_PASSWORD=REPLACE_ME_SMTP_PASSWORD
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=none

### 📩 Correo entrante (opcional)
MAILER_INBOUND_EMAIL_DOMAIN=reply.tudominio.com
RAILS_INBOUND_EMAIL_SERVICE=sendgrid
RAILS_INBOUND_EMAIL_PASSWORD=REPLACE_ME_WEBHOOK_KEY

### 📱 App móvil de Chatwoot
ENABLE_PUSH_RELAY_SERVER=true
IOS_APP_ID=com.chatwoot.app
ANDROID_BUNDLE_ID=com.chatwoot.app

### 🛡️ Seguridad adicional
FORCE_SSL=true
ENABLE_RACK_ATTACK=true
ENABLE_RACK_ATTACK_WIDGET_API=false
